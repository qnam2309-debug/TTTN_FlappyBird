# Cổng chạy server
PORT=5000

# Cấu hình MySQL (XAMPP mặc định)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=TTTN_FlappyBird

# JWT - KHÓA BÍ MẬT (đổi thành chuỗi ngẫu nhiên dài, không tiết lộ cho ai)
JWT_SECRET=thay_bang_chuoi_bi_mat_ngau_nhien
JWT_EXPIRES_IN=7d
