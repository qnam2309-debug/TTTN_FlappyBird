# ============================================================
# File cấu hình mẫu - HÃY COPY thành file ".env" và điền giá trị thật
# (Không commit file .env thật lên Git!)
# ============================================================

# Cổng chạy server
PORT=5000

# Cấu hình MySQL (XAMPP mặc định)
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DB_USER_HERE
DB_PASSWORD=
DB_NAME=TTTN_FlappyBird

# JWT - KHÓA BÍ MẬT (đổi thành chuỗi ngẫu nhiên dài, không tiết lộ cho ai)
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRES_IN=7d

# Google OAuth - Client ID lấy từ Google Cloud Console
# (dùng CHUNG cho cả backend và frontend)
GOOGLE_CLIENT_ID=

# CORS - Domain frontend được phép gọi API (phân cách bởi dấu phẩy)
# Để trống khi chạy local (cho phép tất cả), điền domain Vercel khi deploy
# Ví dụ: CORS_ORIGIN=https://flappy-bird-xxx.vercel.app
CORS_ORIGIN=

# SMTP - Gửi email OTP (tùy chọn)
# Nếu để trống SMTP_HOST/SMTP_USER/SMTP_PASS, backend chạy chế độ DEV:
# OTP được log ra console và trả về devOtp cho frontend (chỉ khi NODE_ENV != production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flappy Bird <no-reply@flappybird.local>
